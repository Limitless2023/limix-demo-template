# LimiX 开放平台。不填 LIMIX_API_KEY 时走模拟模式（页面标明「模拟结果」）。
# Key 向平台管理员申请；只放在 .env.local 或部署平台的环境变量里，不要提交到仓库。
LIMIX_BASE_URL=https://limix-api.stable-ai.cn
LIMIX_API_KEY=
# 模型规格：LIMIX_2M / LIMIX_7M / LIMIX_16M（默认）/ LIMIX_64M
LIMIX_MODEL_TYPE=LIMIX_16M
# 设为 1 时即使有 Key 也走模拟（离线演示、排练时用）
LIMIX_MOCK=

# 访问保护：部署到公网时必须设置，格式「用户名:密码」，浏览器会弹出登录框
DEMO_BASIC_AUTH=
